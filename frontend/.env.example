# AI backend mode (server-side only; never exposed to the client).
# true  = use local mock responses (src/lib/api/mock-risk.ts, mock-plan.ts)
# false = proxy /api/risk and /api/plan to AI_API_BASE_URL
USE_MOCK_AI=true

# Base URL of the FastAPI AI backend. Required when USE_MOCK_AI=false.
# Example: AI_API_BASE_URL=http://localhost:8000
AI_API_BASE_URL=

# Google sign-in credentials. Configure these in .env.local.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
